<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.qingmou.cxnp.mapper.SysUserMapper">

    <!-- 根据用户名查询系统用户 -->
    <select id="selectByUsername"
            resultType="com.qingmou.cxnp.entity.SysUser">

        SELECT
            id,
            username,
            password,
            status,
            created_at AS createdAt
        FROM sys_user
        WHERE username = #{username}

    </select>

    <!-- 根据用户 ID 查询系统用户 -->
    <select id="selectById"
            resultType="com.qingmou.cxnp.entity.SysUser">

        SELECT
            id,
            username,
            password,
            status,
            created_at AS createdAt
        FROM sys_user
        WHERE id = #{id}

    </select>

</mapper>
