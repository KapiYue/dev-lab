<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd"
        >
<mapper namespace="com.qingmou.cxnp.mapper.PartyMemberMapper">
    <sql id="dataScopeCondition">
        <choose>
            <when test="all">
                1 = 1
            </when>
            <otherwise>
                <choose>
                    <when test="(includeSelf and userId != null) or (orgIds != null and orgIds.size() > 0)">
                        <trim prefix="(" suffix=")" prefixOverrides="OR">
                            <if test="includeSelf and userId != null">
                                OR user_id = #{userId}
                            </if>
                            <if test="orgIds != null and orgIds.size() > 0">
                                OR org_id IN
                                <foreach collection="orgIds" item="orgId" open="(" separator="," close=")">
                                    #{orgId}
                                </foreach>
                            </if>
                        </trim>
                    </when>
                    <otherwise>1 = 0</otherwise>
                </choose>
            </otherwise>
        </choose>
    </sql>

    <!-- 列表查询始终携带后端计算的数据范围条件。 -->
    <select id="selectByDataScope"
            resultType="com.qingmou.cxnp.entity.PartyMember">
        SELECT
            id,
            name,
            gender,
            phone,
            join_date,
            party_branch,
            org_id,
            user_id,
            created_at
        FROM party_member
        WHERE
        <include refid="dataScopeCondition"/>
        ORDER BY id
    </select>

    <!-- 详情按 ID 与数据范围同时过滤，避免通过篡改 ID 越权。 -->
    <select id="selectByIdWithinDataScope" resultType="com.qingmou.cxnp.entity.PartyMember">
        SELECT
            id,
            name,
            gender,
            join_date,
            party_branch,
            org_id,
            user_id,
            created_at
        FROM party_member
        WHERE id = #{id}
          AND <include refid="dataScopeCondition"/>
    </select>
</mapper>
