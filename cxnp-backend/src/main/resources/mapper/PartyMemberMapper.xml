<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd"
        >
<mapper namespace="com.qingmou.cxnp.mapper.PartyMemberMapper">
    <select id="selectAll" resultType="com.qingmou.cxnp.entity.PartyMember">
        SELECT
            id,
            name,
            gender,
            phone,
            join_date,
            party_branch,
            created_at
        FROM party_member
    </select>
</mapper>
