<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd"
        >
<mapper namespace="com.qingmou.cxnp.mapper.PartyMemberMapper">
    <!--查询所有-->
    <select id="selectAll"
            parameterType="java.lang.Long"
            resultType="com.qingmou.cxnp.entity.PartyMember">
        SELECT
            id,
            name,
            gender,
            phone,
            join_date,
            party_branch,
            created_at
        FROM party_member
        ORDER BY id
    </select>

<!--    根据ID查询党员详情-->
    <select id="selectById" resultType="com.qingmou.cxnp.entity.PartyMember">

        SELECT
        id,
        name,
        gender,
        join_date,
        party_branch,
        created_at
        FROM party_member
        WHERE id = #{id}
    </select>
</mapper>
