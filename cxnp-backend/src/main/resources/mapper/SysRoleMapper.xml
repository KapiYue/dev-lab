<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.qingmou.cxnp.mapper.SysRoleMapper">

    <!-- 1. 查询所有角色 -->
    <select id="selectAll"
            resultType="com.qingmou.cxnp.entity.SysRole">
        SELECT
        id,
        role_code,
        role_name,
        status,
        created_at
        FROM sys_role
    </select>

    <!-- 2. 根据角色编码查询角色 -->
    <select id="selectByRoleCode"
            resultType="com.qingmou.cxnp.entity.SysRole">
        SELECT
        id,
        role_code,
        role_name,
        status,
        created_at
        FROM sys_role
        WHERE role_code = #{roleCode}
    </select>

    <!-- 3. 根据用户 ID 查询角色 -->
    <select id="selectByUserId"
            resultType="com.qingmou.cxnp.entity.SysRole">
        SELECT
        r.id,
        r.role_code,
        r.role_name,
        r.status,
        r.created_at
        FROM sys_role r
        INNER JOIN sys_user_role ur
        ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>

</mapper>
